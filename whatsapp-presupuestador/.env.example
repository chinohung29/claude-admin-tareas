# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=elegir-una-clave-secreta-propia
META_GRAPH_API_VERSION=v21.0

# Google Sheets (base de datos: Vehículos, Recetas base, Carga repuestos, Universales, Mano de obra)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SHEET_ID=

# IVA de referencia si no se puede leer de la hoja "Mano de obra"
IVA_DEFAULT=0.21

# A dónde avisar cuando falta un dato o hay ambigüedad (Comercial / Repuestos)
COMERCIAL_NOTIFY_EMAIL=
